         SCRIPTS
    ══════════════════════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function mostrarMenu() {
            const barra     = document.getElementById('barraLateral');
            const contenido = document.getElementById('contenidoPrincipal');
            barra.classList.toggle('activa');
            if (contenido) contenido.classList.toggle('movido');
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('visible');
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        function agendarCita() {
            const nombre   = document.querySelector('.campo-input[type="text"]');
            const telefono = document.querySelector('.campo-input[type="tel"]');

            if (!nombre || nombre.value.trim().length < 3) {
                nombre.style.borderColor = '#f87171';
                nombre.focus();
                return;
            }
            nombre.style.borderColor = '';

            if (!telefono || telefono.value.trim().length < 7) {
                telefono.style.borderColor = '#f87171';
                telefono.focus();
                return;
            }
            telefono.style.borderColor = '';

            const msg = document.getElementById('confirmMsg');
            msg.style.display = 'block';
            setTimeout(() => { msg.style.display = 'none'; }, 5000);
        }

        document.querySelectorAll('a[href^="#"]').forEach(a => {
            a.addEventListener('click', e => {
                const target = document.querySelector(a.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>

