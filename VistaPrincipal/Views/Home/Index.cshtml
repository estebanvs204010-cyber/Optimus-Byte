                    </div>

                    <div class="campo-grupo">
                        <label class="campo-label">Tipo de servicio</label>
                        <select class="campo-select">
                            <option value="">¿Qué necesitas?</option>
                            <option>Mantenimiento preventivo</option>
                            <option>Sistema de frenos</option>
                            <option>Diagnóstico electrónico</option>
                            <option>Sistema de refrigeración</option>
                            <option>Suspensión y dirección</option>
                            <option>Revisión técnico-mecánica</option>
                            <option>Otro</option>
                        </select>
                    </div>

                    <div class="form-grid-2">
                        <div class="campo-grupo">
                            <label class="campo-label">Fecha preferida</label>
                            <input class="campo-input" type="date" />
                        </div>
                        <div class="campo-grupo">
                            <label class="campo-label">Horario</label>
                            <select class="campo-select">
                                <option value="">Selecciona…</option>
