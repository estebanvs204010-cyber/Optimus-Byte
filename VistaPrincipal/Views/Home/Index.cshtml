@{
    Layout = null;
    ViewData["Title"] = "Inicio";
    var nombre = ViewBag.UsuarioNombre as string;
    var rol = ViewBag.UsuarioRol as string;
    bool logueado = !string.IsNullOrEmpty(nombre);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Optimus-Byte — Taller Mecánico de Confianza</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>

        /* ══════════════════════════════════════════════
                   HERO — Fondo con imagen + overlay oscuro
                ══════════════════════════════════════════════ */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            overflow: hidden;
            padding-top: var(--alto-barra);
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 80% 60% at 70% 50%, rgba(201,168,76,0.06) 0%, transparent 70%), radial-gradient(ellipse 40% 80% at 90% 20%, rgba(201,168,76,0.04) 0%, transparent 60%), linear-gradient(160deg, #080a0e 0%, #111318 40%, #0d1018 100%);
            z-index: 0;
        }

        .hero-grid {
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
            background-size: 60px 60px;
            z-index: 0;
            mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 30%, transparent 100%);
        }

        .hero-circle {
            position: absolute;
            right: -120px;
            top: 50%;
            transform: translateY(-50%);
            width: 700px;
            height: 700px;
            border-radius: 50%;
            border: 1px solid rgba(201,168,76,0.08);
            z-index: 0;
        }

            .hero-circle::before {
                content: '';
                position: absolute;
                inset: 60px;
                border-radius: 50%;
                border: 1px solid rgba(201,168,76,0.06);
            }

            .hero-circle::after {
                content: '';
                position: absolute;
                inset: 120px;
                border-radius: 50%;
                border: 1px dashed rgba(201,168,76,0.05);
            }

        .hero-content {
            position: relative;
            z-index: 2;
            padding: 80px 0 100px;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: var(--dorado);
            margin-bottom: 24px;
        }

            .hero-eyebrow::before {
                content: '';
                display: block;
                width: 28px;
                height: 1px;
                background: var(--dorado);
            }

        .hero-title {
            font-family: var(--fuente-titulo);
            font-size: clamp(3rem, 6vw, 5.5rem);
            font-weight: 300;
            color: var(--marfil);
            line-height: 1.05;
            margin-bottom: 28px;
            letter-spacing: -0.02em;
        }

            .hero-title strong {
                font-weight: 600;
                color: var(--dorado);
                display: block;
            }

            .hero-title em {
                font-style: italic;
                color: rgba(245,240,232,0.6);
            }

        .hero-desc {
            font-size: 1.05rem;
            color: var(--texto-claro);
            max-width: 480px;
            line-height: 1.8;
            margin-bottom: 44px;
            opacity: 0.85;
        }

        .hero-ctas {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            align-items: center;
        }

        .hero-cta-primary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--dorado);
            color: var(--negro);
            text-decoration: none;
            padding: 14px 36px;
            border-radius: var(--radio);
            font-weight: 600;
            font-size: 0.82rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            transition: var(--transicion);
            font-family: var(--fuente-cuerpo);
        }

            .hero-cta-primary:hover {
                background: var(--dorado-claro);
                transform: translateY(-2px);
                box-shadow: 0 8px 28px rgba(201,168,76,0.4);
                color: var(--negro);
            }

        .hero-cta-secondary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: transparent;
            color: var(--dorado);
            text-decoration: none;
            padding: 14px 32px;
            border-radius: var(--radio);
            border: 1px solid rgba(201,168,76,0.4);
            font-size: 0.82rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            transition: var(--transicion);
            font-family: var(--fuente-cuerpo);
        }

            .hero-cta-secondary:hover {
                background: rgba(201,168,76,0.08);
                border-color: var(--dorado);
                color: var(--dorado);
            }

        .hero-stats {
            display: flex;
            gap: 48px;
            margin-top: 64px;
            padding-top: 40px;
            border-top: 1px solid var(--borde);
            flex-wrap: wrap;
        }

        .hero-stat-num {
            font-family: var(--fuente-titulo);
            font-size: 2.4rem;
            font-weight: 600;
            color: var(--dorado);
            line-height: 1;
            display: block;
        }

        .hero-stat-lbl {
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--texto-suave);
            margin-top: 6px;
            display: block;
        }

        .hero-visual {
            position: absolute;
            right: 4%;
            top: 50%;
            transform: translateY(-50%);
            z-index: 1;
            opacity: 0.18;
            width: 520px;
        }

        /* ══════════════════════════════════════════════
                   SECCIÓN COMPARTIDA
                ══════════════════════════════════════════════ */
        .seccion {
            padding: 100px 0;
        }

        .seccion-alt {
            background: rgba(255,255,255,0.015);
            border-top: 1px solid var(--borde);
            border-bottom: 1px solid var(--borde);
        }

        .sec-eyebrow {
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--dorado);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .sec-eyebrow::before {
                content: '';
                width: 22px;
                height: 1px;
                background: var(--dorado);
            }

        .sec-titulo {
            font-family: var(--fuente-titulo);
            font-size: clamp(2rem, 3.5vw, 3rem);
            font-weight: 300;
            color: var(--marfil);
            line-height: 1.15;
            margin-bottom: 16px;
        }

            .sec-titulo em {
                color: var(--dorado);
                font-style: italic;
            }

        .sec-desc {
            color: var(--texto-suave);
            font-size: 0.95rem;
            line-height: 1.8;
            max-width: 500px;
        }

        /* ══════════════════════════════════════════════
                   SERVICIOS
                ══════════════════════════════════════════════ */
        .servicios-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            margin-top: 56px;
        }

        .servicio-card {
            background: var(--grafito);
            border: 1px solid var(--borde);
            border-radius: var(--radio-m);
            padding: 36px 32px;
            position: relative;
            overflow: hidden;
            transition: var(--transicion);
        }

            .servicio-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 3px;
                height: 0;
                background: var(--dorado);
                transition: height 0.4s ease;
            }

            .servicio-card:hover {
                border-color: rgba(201,168,76,0.3);
                background: var(--grafito-med);
                transform: translateY(-4px);
                box-shadow: var(--sombra-m);
            }

                .servicio-card:hover::before {
                    height: 100%;
                }

        .servicio-icon {
            font-size: 2.2rem;
            margin-bottom: 20px;
            display: block;
        }

        .servicio-nombre {
            font-family: var(--fuente-titulo);
            font-size: 1.3rem;
            font-weight: 400;
            color: var(--marfil);
            margin-bottom: 10px;
        }

        .servicio-desc {
            font-size: 0.85rem;
            color: var(--texto-suave);
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .servicio-precio {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--dorado);
            font-weight: 500;
        }

        /* ══════════════════════════════════════════════
                   REPUESTOS DESTACADOS
                ══════════════════════════════════════════════ */
        .repuestos-intro {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 48px;
            flex-wrap: wrap;
        }

        .precio-repuesto {
            display: inline-block;
            margin-top: 10px;
            font-family: var(--fuente-titulo);
            font-size: 1.15rem;
            color: var(--dorado-claro);
        }

        /* ══════════════════════════════════════════════
                   CITAS
                ══════════════════════════════════════════════ */
        .citas-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .citas-form-card {
            background: var(--grafito);
            border: 1px solid var(--borde);
            border-radius: var(--radio-m);
            padding: 44px;
        }

        .citas-form-titulo {
            font-family: var(--fuente-titulo);
            font-size: 1.6rem;
            color: var(--marfil);
            margin-bottom: 6px;
        }

        .citas-form-sub {
            font-size: 0.82rem;
            color: var(--texto-suave);
            margin-bottom: 32px;
        }

        .campo-grupo {
            margin-bottom: 20px;
        }

        .campo-label {
            display: block;
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--texto-suave);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .campo-input,
        .campo-select,
        .campo-textarea {
            width: 100%;
            background: var(--grafito-med);
            border: 1px solid rgba(255,255,255,0.07);
            color: var(--marfil);
            padding: 12px 16px;
            border-radius: var(--radio);
            font-family: var(--fuente-cuerpo);
            font-size: 0.88rem;
            transition: var(--transicion);
            outline: none;
        }

            .campo-input::placeholder,
            .campo-textarea::placeholder {
                color: var(--texto-suave);
                opacity: 0.6;
            }

            .campo-input:focus,
            .campo-select:focus,
            .campo-textarea:focus {
                border-color: var(--dorado);
                box-shadow: 0 0 0 3px rgba(201,168,76,0.1);
            }

            .campo-select option {
                background: var(--grafito-med);
            }

        .campo-textarea {
            min-height: 100px;
            resize: vertical;
        }

        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .btn-agendar {
            width: 100%;
            background: var(--dorado);
            color: var(--negro);
            border: none;
            padding: 14px;
            border-radius: var(--radio);
            font-family: var(--fuente-cuerpo);
            font-weight: 600;
            font-size: 0.82rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            cursor: pointer;
            transition: var(--transicion);
            margin-top: 8px;
        }

            .btn-agendar:hover {
                background: var(--dorado-claro);
                box-shadow: 0 4px 20px rgba(201,168,76,0.35);
            }

        .beneficio-item {
            display: flex;
            gap: 20px;
            align-items: flex-start;
            padding: 24px 0;
            border-bottom: 1px solid var(--borde);
        }

            .beneficio-item:last-child {
                border-bottom: none;
            }

        .beneficio-icon {
            width: 48px;
            height: 48px;
            background: var(--dorado-suave);
            border: 1px solid rgba(201,168,76,0.2);
            border-radius: var(--radio);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .beneficio-titulo {
            font-family: var(--fuente-titulo);
            font-size: 1.1rem;
            color: var(--marfil);
            margin-bottom: 4px;
        }

        .beneficio-texto {
            font-size: 0.83rem;
            color: var(--texto-suave);
            line-height: 1.6;
        }

        .confirm-msg {
            display: none;
            background: rgba(74,222,128,0.08);
            border: 1px solid rgba(74,222,128,0.3);
            color: #4ade80;
            padding: 14px 18px;
            border-radius: var(--radio);
            font-size: 0.85rem;
            margin-top: 16px;
            text-align: center;
        }

        /* ══════════════════════════════════════════════
                   SOBRE NOSOTROS
                ══════════════════════════════════════════════ */
        .sobre-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }

        .sobre-img-card {
            background: var(--grafito);
            border: 1px solid var(--borde);
            border-radius: var(--radio-m);
            padding: 48px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .sobre-img-card::before {
                content: '';
                position: absolute;
                top: -40px;
                right: -40px;
                width: 200px;
                height: 200px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(201,168,76,0.1), transparent 70%);
            }

        .sobre-badge {
            position: absolute;
            bottom: -18px;
            right: 24px;
            background: var(--dorado);
            color: var(--negro);
            padding: 14px 20px;
            border-radius: var(--radio);
            font-family: var(--fuente-titulo);
            font-size: 1.8rem;
            font-weight: 600;
            line-height: 1;
            box-shadow: var(--sombra-m);
        }

            .sobre-badge span {
                display: block;
                font-family: var(--fuente-cuerpo);
                font-size: 0.65rem;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                font-weight: 500;
                margin-top: 2px;
            }

        .sobre-valores {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 36px;
        }

        .valor-item {
            background: var(--grafito);
            border: 1px solid var(--borde);
            border-radius: var(--radio);
            padding: 18px;
            transition: var(--transicion);
        }

            .valor-item:hover {
                border-color: rgba(201,168,76,0.3);
                background: var(--grafito-med);
            }

        .valor-icon {
            font-size: 1.4rem;
            margin-bottom: 8px;
            display: block;
        }

        .valor-nombre {
            font-size: 0.82rem;
            font-weight: 500;
            color: var(--marfil);
            letter-spacing: 0.04em;
        }

        /* ══════════════════════════════════════════════
                   MENÚ USUARIO (dropdown de sesión)
                ══════════════════════════════════════════════ */
        .nav-acciones {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-left: auto;
        }

        .usuario-dropdown .btn-usuario {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: transparent;
            border: 1px solid rgba(201,168,76,0.35);
            color: var(--marfil);
            padding: 7px 14px;
            border-radius: var(--radio);
            font-family: var(--fuente-cuerpo);
            font-size: 0.82rem;
            cursor: pointer;
            transition: var(--transicion);
        }

            .usuario-dropdown .btn-usuario:hover {
                border-color: var(--dorado);
                background: rgba(201,168,76,0.07);
            }

        .usuario-avatar {
            font-size: 1.2rem;
            line-height: 1;
        }

        .usuario-nombre {
            max-width: 130px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .chevron-icon {
            font-size: 0.72rem;
            opacity: 0.7;
        }

        .menu-usuario {
            background: #111318 !important;
            border: 1px solid rgba(201,168,76,0.2) !important;
            border-radius: var(--radio-m) !important;
            min-width: 220px;
            padding: 6px 0 !important;
            box-shadow: 0 12px 40px rgba(0,0,0,0.5) !important;
        }

        .menu-header {
            padding: 12px 18px 10px;
        }

        .menu-header-nombre {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--marfil);
        }

        .menu-header-rol {
            font-size: 0.72rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--dorado);
            margin-top: 2px;
        }

        .divider-dorado {
            border-color: rgba(201,168,76,0.15) !important;
            margin: 4px 0 !important;
        }

        .item-menu {
            display: flex !important;
            align-items: center;
            gap: 10px;
            color: var(--texto-suave) !important;
            font-size: 0.85rem !important;
            padding: 9px 18px !important;
            transition: var(--transicion);
            background: transparent !important;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

            .item-menu i {
                font-size: 1rem;
            }

            .item-menu:hover {
                color: var(--dorado) !important;
                background: rgba(201,168,76,0.07) !important;
            }

        .item-salir:hover {
            color: #f87171 !important;
            background: rgba(248,113,113,0.07) !important;
        }

        /* ══════════════════════════════════════════════
                   NAV ESCRITORIO (sin sesión)
                ══════════════════════════════════════════════ */
        .nav-links {
            display: flex;
            gap: 4px;
            align-items: center;
        }

        .nav-link-item {
            color: var(--texto-suave);
            font-size: .75rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            padding: 8px 14px;
            text-decoration: none;
            transition: .2s;
        }

            .nav-link-item:hover {
                color: var(--dorado);
            }

        /* ══════════════════════════════════════════════
                   ANIMACIONES
                ══════════════════════════════════════════════ */
        .reveal {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }

            .reveal.visible {
                opacity: 1;
                transform: translateY(0);
            }

        /* ══════════════════════════════════════════════
                   RESPONSIVE
                ══════════════════════════════════════════════ */
        @@media (max-width: 992px) {
            .servicios-grid {
                grid-template-columns: 1fr 1fr;
            }

            .citas-wrapper {
                grid-template-columns: 1fr;
            }

            .sobre-wrapper {
                grid-template-columns: 1fr;
                gap: 48px;
            }

            .hero-visual {
                display: none;
            }
        }

        @@media (max-width: 640px) {
            .servicios-grid {
                grid-template-columns: 1fr;
            }

            .form-grid-2 {
                grid-template-columns: 1fr;
            }

            .sobre-valores {
                grid-template-columns: 1fr;
            }

            .hero-stats {
                gap: 28px;
            }

            .citas-form-card {
                padding: 28px 20px;
            }
        }

    </style>
</head>

<body>

    <!-- ══════════════════════════════════════════════════════
         NAVBAR
    ══════════════════════════════════════════════════════ -->
    <header class="barra-superior">
        <button class="boton-menu" onclick="mostrarMenu()" aria-label="Menú">☰</button>

        <a class="logo-proyecto" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo-optimus-byte.png" alt="Optimus-Byte" class="logo-img" />
        </a>

        <div class="nav-acciones">

            @if (!logueado)
            {
                @* Sin sesión: links de navegación + botones *@
                <nav class="nav-links d-none d-lg-flex">
                    <a class="nav-link-item" href="#servicios">Servicios</a>
                    <a class="nav-link-item" href="#repuestos">Repuestos</a>
                    <a class="nav-link-item" href="#citas">Citas</a>
                    <a class="nav-link-item" href="#sobre">Nosotros</a>
                </nav>
                <a class="boton-ingresar" asp-controller="Login" asp-action="Index">Ingresar</a>
                <a class="boton-registro" asp-controller="Registro" asp-action="Index">Registrar</a>
            }
            else
            {
                @* Con sesión: menú desplegable de usuario *@
                <div class="dropdown usuario-dropdown">
                    <button class="btn-usuario dropdown-toggle" type="button"
                            id="menuUsuario" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="usuario-avatar"><i class="bi bi-person-circle"></i></span>
                        <span class="usuario-nombre">@nombre</span>
                        <i class="bi bi-chevron-down chevron-icon"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end menu-usuario" aria-labelledby="menuUsuario">

                        <li class="menu-header">
                            <div class="menu-header-nombre">@nombre</div>
                            <div class="menu-header-rol">@rol</div>
                        </li>
                        <li><hr class="dropdown-divider divider-dorado"></li>

                        <li>
                            <a class="dropdown-item item-menu" asp-controller="Home" asp-action="Perfil">
                                <i class="bi bi-person-gear"></i> Configurar perfil
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item item-menu" asp-controller="Citas" asp-action="Index">
                                <i class="bi bi-calendar-check"></i> Mis citas
                            </a>
                        </li>

                        @if (rol == "Administrador" || rol == "Admin")
                        {
                            <li><hr class="dropdown-divider divider-dorado"></li>
                            <li>
                                <a class="dropdown-item item-menu" asp-controller="Inventario" asp-action="Index">
                                    <i class="bi bi-box-seam"></i> Inventario
                                </a>
                            </li>
                            <li>
