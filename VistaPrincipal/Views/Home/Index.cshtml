                    <span class="servicio-precio">Desde $120.000 COP</span>
                </div>
                <div class="servicio-card reveal" style="transition-delay:.16s">
                    <span class="servicio-icon">⚡</span>
                    <div class="servicio-nombre">Diagnóstico Electrónico</div>
