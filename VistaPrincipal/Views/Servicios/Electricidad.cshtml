@{
    ViewData["Title"] = "Electricidad Automotriz";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Optimus-Byte</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">
                        <span class="badge text-bg-info mb-3">Eléctrico</span>
                        <h1 class="fw-bold mb-3">Electricidad Automotriz</h1>
                        <p class="text-muted mb-0">Diagnóstico e instalación de sistemas eléctricos para asegurar un funcionamiento confiable.</p>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <h5 class="fw-semibold mb-3">Servicios incluidos</h5>
                        <div class="row g-3">
                            <div class="col-md-6"><div class="p-3 bg-white border rounded-3">Baterías.</div></div>
                            <div class="col-md-6"><div class="p-3 bg-white border rounded-3">Alternadores.</div></div>
                            <div class="col-md-6"><div class="p-3 bg-white border rounded-3">Cableado.</div></div>
                            <div class="col-md-6"><div class="p-3 bg-white border rounded-3">Luces y circuitos.</div></div>
                        </div>
                        <div class="mt-4">
                            <a class="btn btn-info text-white" asp-controller="Servicios" asp-action="Index">Volver a servicios</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>