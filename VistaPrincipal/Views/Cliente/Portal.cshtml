@{
    ViewData["Title"] = "Mi Portal";
    Layout = null;
    var nombre = ViewBag.Nombre as string ?? "Cliente";
    var inicial = nombre.Length > 0 ? nombre[0].ToString().ToUpper() : "C";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>OPTIMUS-BYTE — Mi Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root {
            --negro: #070709;
            --carbon: #0d0f13;
            --grafito: #141720;
            --grafito-med: #1c2028;
            --grafito-claro: #242935;
            --dorado: #c9a84c;
            --dorado-claro: #e2c47a;
            --dorado-suave: rgba(201,168,76,0.10);
            --marfil: #f0ebe0;
            --texto-claro: #c8cdd6;
            --texto-suave: #6b7480;
            --borde: rgba(201,168,76,0.15);
            --borde-input: rgba(255,255,255,0.07);
            --exito: #4ade80;
            --transicion: 0.3s cubic-bezier(0.4,0,0.2,1);
            --fuente-titulo: 'Cormorant Garamond', Georgia, serif;
            --fuente-cuerpo: 'Jost','Segoe UI',sans-serif;
        }

        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0; padding: 0;
            background: var(--negro);
            color: var(--texto-claro);
            font-family: var(--fuente-cuerpo);
            font-weight: 300;
            min-height: 100vh;
        }

        /* ── Topbar ── */
        .topbar {
            position: fixed; top: 0; left: 0; right: 0;
            height: 62px;
            background: var(--carbon);
            border-bottom: 1px solid var(--borde);
            display: flex; align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            z-index: 100;
        }
        .brand {
            font-family: var(--fuente-titulo);
            font-size: 1.4rem; font-weight: 600;
            color: var(--dorado); letter-spacing: 0.04em;
        }
        .badge-rol {
            font-size: 0.65rem; letter-spacing: 0.12em;
            text-transform: uppercase; color: var(--dorado);
            background: var(--dorado-suave);
            border: 1px solid var(--borde);
            padding: 3px 10px; border-radius: 2px;
        }
        .user-name {
            font-size: 0.82rem; color: var(--texto-suave);
        }
        .btn-salir {
            font-size: 0.75rem; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--texto-suave);
            text-decoration: none;
            border: 1px solid rgba(255,255,255,0.08);
            padding: 6px 14px; border-radius: 2px;
            transition: var(--transicion);
        }
        .btn-salir:hover { color: #e05a5a; border-color: rgba(224,90,90,0.3); }

        /* ── Contenido ── */
        .page {
            padding: 94px 40px 40px;
            max-width: 1100px;
            margin: 0 auto;
        }

        /* ── Bienvenida ── */
        .welcome-bar {
            display: flex; align-items: center;
            gap: 20px;
            background: var(--grafito);
            border: 1px solid var(--borde-input);
            border-left: 3px solid var(--dorado);
            border-radius: 4px;
            padding: 22px 28px;
            margin-bottom: 32px;
        }
        .avatar {
            width: 52px; height: 52px;
            border-radius: 50%;
            background: var(--dorado-suave);
            border: 2px solid var(--borde);
            display: flex; align-items: center; justify-content: center;
            font-family: var(--fuente-titulo);
            font-size: 1.6rem; color: var(--dorado); font-weight: 600;
            flex-shrink: 0;
        }
        .welcome-txt h2 {
            font-family: var(--fuente-titulo);
            font-size: 1.7rem; font-weight: 400;
            color: var(--marfil); margin: 0 0 3px;
        }
        .welcome-txt p { margin: 0; font-size: 0.82rem; color: var(--texto-suave); }

        /* ── Tarjetas de acceso rápido ── */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .portal-card {
            background: var(--grafito);
            border: 1px solid var(--borde-input);
            border-radius: 4px;
            padding: 28px 24px;
            text-decoration: none;
            color: inherit;
            transition: var(--transicion);
            display: flex; flex-direction: column; gap: 14px;
            position: relative; overflow: hidden;
        }
        .portal-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0;
            height: 2px;
            background: var(--dorado);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
        }
        .portal-card:hover { border-color: var(--borde); transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.3); }
        .portal-card:hover::before { transform: scaleX(1); }

        .card-icon {
            width: 48px; height: 48px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
        }
        .icon-dorado { background: rgba(201,168,76,0.12); color: var(--dorado); }
        .icon-azul   { background: rgba(56,189,248,0.10); color: #7dd3fc; }
        .icon-verde  { background: rgba(74,222,128,0.09); color: #86efac; }
        .icon-morado { background: rgba(167,139,250,0.10); color: #c4b5fd; }

        .card-title {
            font-family: var(--fuente-titulo);
            font-size: 1.2rem; font-weight: 400;
            color: var(--marfil); margin: 0;
        }
        .card-desc {
            font-size: 0.78rem; color: var(--texto-suave);
            line-height: 1.5; margin: 0;
        }
        .card-arrow {
            margin-top: auto;
            font-size: 0.7rem; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--dorado);
            display: flex; align-items: center; gap: 6px;
        }

        /* ── Sección info ── */
        .info-section {
            background: var(--grafito);
            border: 1px solid var(--borde-input);
            border-radius: 4px;
            padding: 28px;
        }
        .info-title {
            font-family: var(--fuente-titulo);
            font-size: 1.4rem; font-weight: 400;
            color: var(--marfil); margin: 0 0 6px;
        }
        .info-sub { font-size: 0.78rem; color: var(--texto-suave); margin: 0 0 22px; }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
        }
        .info-item {
            display: flex; align-items: flex-start; gap: 12px;
            padding: 14px 16px;
            background: var(--grafito-med);
            border: 1px solid var(--borde-input);
            border-radius: 3px;
        }
        .info-item i { font-size: 1.1rem; color: var(--dorado); margin-top: 2px; }
        .info-item-txt strong {
            display: block; font-size: 0.75rem;
            letter-spacing: 0.07em; text-transform: uppercase;
            color: var(--texto-suave); margin-bottom: 3px;
        }
        .info-item-txt span { font-size: 0.88rem; color: var(--texto-claro); }

        /* ── Próximamente badge ── */
        .soon-badge {
            font-size: 0.6rem; letter-spacing: 0.1em;
            text-transform: uppercase;
            background: rgba(201,168,76,0.08);
            border: 1px solid rgba(201,168,76,0.2);
            color: var(--dorado); padding: 2px 7px; border-radius: 2px;
            vertical-align: middle; margin-left: 8px;
        }

      
    </style>
</head>
<body>

    <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <span class="brand">⚙ OPTIMUS-BYTE</span>
            <span class="badge-rol">Cliente</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="user-name">
                <i class="bi bi-person-circle me-1"></i>@nombre
            </span>
            <a href="/Login/Logout" class="btn-salir">
                <i class="bi bi-box-arrow-right me-1"></i>Salir
            </a>
        </div>
    </div>

    <div class="page">

        <!-- Bienvenida -->
        <div class="welcome-bar">
            <div class="avatar">@inicial</div>
            <div class="welcome-txt">
                <h2>Bienvenido, @nombre</h2>
                <p>Este es tu portal de consulta. Aquí puedes ver el estado de tu vehículo y tus servicios.</p>
            </div>
        </div>

        <!-- Tarjetas -->
        <div class="cards-grid">

            <a href="/Cliente/MisVehiculos" class="portal-card">
                <div class="card-icon icon-dorado">
                    <i class="bi bi-car-front-fill"></i>
                </div>
                <p class="card-title">Mis Vehículos</p>
                <p class="card-desc">Consulta los vehículos registrados a tu nombre en el taller.</p>
                <div class="card-arrow">
                    Ver vehículos <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <a href="/Cliente/MisOrdenes" class="portal-card">
                <div class="card-icon icon-azul">
                    <i class="bi bi-clipboard2-check-fill"></i>
                </div>
                <p class="card-title">Mis Órdenes</p>
                <p class="card-desc">Revisa el estado actual de tus órdenes de trabajo y diagnósticos.</p>
                <div class="card-arrow">
                    Ver órdenes <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <a href="/Cliente/MisFacturas" class="portal-card">
                <div class="card-icon icon-verde">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <p class="card-title">Mis Facturas <span class="soon-badge">Pronto</span></p>
                <p class="card-desc">Descarga y consulta el historial de pagos y facturas emitidas.</p>
                <div class="card-arrow">
                    Ver facturas <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <a href="/Cliente/Mantenimiento" class="portal-card">
                <div class="card-icon icon-morado">
                    <i class="bi bi-tools"></i>
                </div>
                <p class="card-title">Mantenimiento <span class="soon-badge">Pronto</span></p>
                <p class="card-desc">Consulta los próximos mantenimientos recomendados para tu vehículo.</p>
                <div class="card-arrow">
                    Ver plan <i class="bi bi-arrow-right"></i>
                </div>
            </a>

        </div>

        <!-- Info del taller -->
        <div class="info-section">
            <p class="info-title">Información del Taller</p>
            <p class="info-sub">Contáctanos si necesitas agendar o tienes alguna duda</p>
            <div class="info-grid">
                <div class="info-item">
                    <i class="bi bi-telephone-fill"></i>
                    <div class="info-item-txt">
                        <strong>Teléfono</strong>
                        <span>+57 318 509 4530</span>
                    </div>
                </div>
                <div class="info-item">
                    <i class="bi bi-envelope-fill"></i>
                    <div class="info-item-txt">
                        <strong>Correo</strong>
                        <span>louisfonsea070&#64;gmail.com</span>
                    </div>
                </div>
                <div class="info-item">
                    <i class="bi bi-clock-fill"></i>
                    <div class="info-item-txt">
                        <strong>Horario</strong>
                        <span>Lun – Sáb · 8:00 am – 6:00 pm</span>
                    </div>
                </div>
                <div class="info-item">
                    <i class="bi bi-geo-alt-fill"></i>
                    <div class="info-item-txt">
                        <strong>Ubicación</strong>
                        <span>Colombia</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
