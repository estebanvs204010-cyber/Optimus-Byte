<h2>Agregar al carrito</h2>

<form method="post">
    <div>
        <label>Nombre:</label>
        <input type="text" name="Nombre" required />
    </div>

    <div>
        <label>Precio:</label>
        <input type="number" name="Precio" required />
    </div>

    <div>
        <label>Cantidad:</label>
        <input type="number" name="Cantidad" required />
    </div>

    <button type="submit">Agregar</button>
</form>