@model VistaPrincipal.Models.CarritoItem

<h2>Editar producto</h2>

<form method="post">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div>
        <label>Nombre:</label>
        <input type="text" name="Nombre" value="@Model.Nombre" />
    </div>

    <div>
        <label>Precio:</label>
        <input type="number" name="Precio" value="@Model.Precio" />
    </div>

    <div>
        <label>Cantidad:</label>
        <input type="number" name="Cantidad" value="@Model.Cantidad" />
    </div>

    <button type="submit">Guardar cambios</button>
</form>