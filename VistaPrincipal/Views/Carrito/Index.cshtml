@model List<VistaPrincipal.Models.CarritoItem>

<h2>Carrito</h2>

<a asp-action="Agregar" class="btn btn-primary">Agregar Producto</a>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            decimal total = 0;

            foreach (var item in Model)
            {
                var subtotal = item.Precio * item.Cantidad;
                total += subtotal;

                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Precio</td>
                    <td>@item.Cantidad</td>
                    <td>@subtotal</td>
                </tr>
            }

        }
        else
        {
            <tr>
                <td colspan="4">El carrito está vacío</td>
            </tr>
        }
    </tbody>
</table>

<h3>
    Total:
    @{
        decimal totalFinal = 0;
        if (Model != null)
        {
            foreach (var item in Model)
            {
                totalFinal += item.Precio * item.Cantidad;
            }
        }
    }
    @totalFinal
</h3>